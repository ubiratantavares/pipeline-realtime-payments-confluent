# ---------------------------------------------------------
# Credenciais, Chaves e Variáveis de Ambiente (CRÍTICO)
# ---------------------------------------------------------
# Garante que nenhum segredo real ou chave de API seja versionado
.env
.env.local
.env.*.local
*.env

# Certificados, chaves privadas e credenciais de nuvem
*.pem
*.key
*.cert
*.crt
credentials.json
service-account*.json
confluent_config*

# ---------------------------------------------------------
# Confluent CLI e Ferramentas Locais
# ---------------------------------------------------------
# Arquivos de estado e cache da CLI
.confluent/
confluent_history
*.delta
*.checkpoint

# ---------------------------------------------------------
# Arquivos do Sistema Operacional e Editores
# ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------
# Logs e Arquivos Temporários de Execução
# ---------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/

# ---------------------------------------------------------
# Python / Scripts Locais (se utilizados para carga/seed)
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
